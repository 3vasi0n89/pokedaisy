+++ b/app/src/test/kotlin/com/pokedaisy/app/companion/data/EecMapTest.kt
@@ -0,0 +1,64 @@
+package com.pokedaisy.app.companion.data
+
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Emerald Extended Cut's bundled map tables (MapSecDataEec.kt, from gen_expansion_tables.py's "eec"): its
+ * Hoenn + Johto + Kanto continent, u16 cursor grid and the switch that picks them (no ROM needed).
+ */
+class EecMapTest {
+    private val eec = RegionMapModel(regionMapImagesEec, mapSecDataEec, regionLayoutsEec)
+
+    @After fun reset() {
+        eecMap = false
+        activeGame = GameKind.FIRERED
+    }
+
+    @Test fun gridIsTwentyEightByFifteenOfNamedSections() {
+        val l = regionLayoutsEec.single()
+        assertEquals(28 * 15, l.cells(0).size)
+        assertEquals(0x102, l.none)
+        for (m in l.cells(0)) assertTrue("mapsec $m", m == l.none || m in eec.sections)
+    }
+
+    @Test fun tapNamesWhatTheGameCursorWould() {
+        assertEquals(MapPick(0, -1), eec.pick(0, 5, 14)) // Littleroot Town
+        assertEquals(MapPick(88, -1), eec.pick(0, 17, 9)) // Pallet Town
+        assertEquals(MapPick(226, -1), eec.pick(0, 6, 6)) // Goldenrod City
+        assertEquals(MapPick(240, -1), eec.pick(0, 12, 7)) // Newbark Town
+        assertNull(eec.pick(0, 0, 0)) // the screen's border, off the grid
+    }
+
+    @Test fun newPlacesPastVanillasLastSectionAreThere() {
+        assertEquals("Ilex Forest", mapSecDataEec.getValue(239).name)
+        assertEquals("Heavenly Palace", mapSecDataEec.getValue(257).name)
+        assertFalse(238 in mapSecDataEec) // an empty slot in the ROM's table
+        assertEquals(listOf(MapTiles(12, 7, 1, 1)), eec.tilesOf(240))
+    }
+
+    @Test fun onlyTheExtendedCutRomSwitchesTheTablesOn() {
+        activeGame = GameKind.EMERALD
+        eecMap = false
+        assertEquals(regionMapImagesEmerald.toList(), activeRegionMapImages.toList())
+        assertEquals("Littleroot Town", activeMapSecData.getValue(0).name)
+        assertNull(activeMapSecData[239])
+
+        eecMap = true
+        assertEquals(listOf("eec"), activeRegionMapImages.toList())
+        assertEquals("Ilex Forest", activeMapSecData.getValue(239).name)
+        assertEquals(88, activeRegionMap()?.pick(0, 17, 9)?.mapsec)
+
+        // The flag means nothing for another game.
+        activeGame = GameKind.IMPERIUM
+        assertEquals(regionMapImagesImperium.toList(), activeRegionMapImages.toList())
+    }
+
+    @Test fun theBuiltInHashIsHotfix16() {
+        assertTrue("1cba867852e3ce5d8b04e1534cabe49344296ad5" in EEC_SHA1S)
+    }
+}
