@@ -104,7 +104,8 @@ class TelemetrySampler {
 
     private fun useBestEffort(m: BestEffort.Match) {
         kind = m.candidate.kind
-        nativeCfg = m.config
+        // Emerald Extended Cut reads as retail Emerald but keeps a few variables elsewhere (eecConfig).
+        nativeCfg = if (m.candidate.cfg === NATIVE_EMERALD_RETAIL && beSha1?.lowercase() in EEC_SHA1S) eecConfig(m.config) else m.config
         baseCfg = m.candidate.cfg
         unsupportedHackLabel = null
         beMatch = m
diff --git a/app/src/test/kotlin/com/pokedaisy/app/companion/data/EecMapTest.kt b/app/src/test/kotlin/com/pokedaisy/app/companion/data/EecMapTest.kt
