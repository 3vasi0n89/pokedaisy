--- a/app/src/main/kotlin/com/pokedaisy/app/companion/data/ActiveTables.kt
+++ b/app/src/main/kotlin/com/pokedaisy/app/companion/data/ActiveTables.kt
@@ -162,6 +162,16 @@ val EEC_SHA1S = setOf(
     "1cba867852e3ce5d8b04e1534cabe49344296ad5", // Classic+ Hotfix 1.6
 )
 
+/**
+ * Emerald Extended Cut is a rebuild, not a patch of retail: its party, battle and save-block pointers are retail's,
+ * but a few EWRAM variables moved. Counted from its literal pools (no reference left to retail's addresses):
+ * gMapHeader 0x02037318 -> 0x020373A8 (144 references) and gObjectEvents 0x02037350 -> 0x020373E0 (400), both +0x90;
+ * gBagPockets 0x02039DD8 -> 0x02039EE4, from SetBagItemsPointers (0x080DA8B0: the same five pockets, offsets and
+ * capacities as retail). Read through retail's, the MAP's player marker sat on a stale map section.
+ */
+fun eecConfig(cfg: NativeConfig): NativeConfig =
+    cfg.copy(mapHeader = 0x020373A8L, objectEvents = 0x020373E0L, bagPockets = 0x02039EE4L)
+
 /** The running game is an Emerald hack with its own text ([emeraldHack]), laid over Emerald's. */
 val runningEmeraldHack: HackText? get() = emeraldHack?.takeIf { activeGame == GameKind.EMERALD }
 
