@@ -58,6 +58,21 @@ class EecMapTest {
         assertEquals(regionMapImagesImperium.toList(), activeRegionMapImages.toList())
     }
 
+    @Test fun itsMovedRamIsReadWhereTheRomKeepsIt() {
+        val c = eecConfig(NATIVE_EMERALD_RETAIL)
+        assertEquals(0x020373A8L, c.mapHeader)
+        assertEquals(0x020373E0L, c.objectEvents)
+        assertEquals(0x02039EE4L, c.bagPockets)
+        assertEquals(0x088F1E40L, c.monIconTable)
+        assertEquals(0x0898B6FCL, c.itemIconTable)
+        // A best effort match that switched retail's icons off still gets EEC's.
+        val off = NATIVE_EMERALD_RETAIL.copy(monIconTable = 0, monIconPaletteIndices = 0, monIconPaletteTable = 0, itemIconTable = 0)
+        assertEquals(0x088F26D8L, eecConfig(off).monIconPaletteTable)
+        // The rest is retail's: the party, battle and save-block pointers didn't move.
+        assertEquals(NATIVE_EMERALD_RETAIL.playerParty, c.playerParty)
+        assertEquals(NATIVE_EMERALD_RETAIL.saveBlock1Ptr, c.saveBlock1Ptr)
+    }
+
     @Test fun theBuiltInHashIsHotfix16() {
         assertTrue("1cba867852e3ce5d8b04e1534cabe49344296ad5" in EEC_SHA1S)
     }
